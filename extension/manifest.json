{
  "manifest_version": 3,
  "name": "AutoLogin (Keychain)",
  "version": "1.0",
  "description": "Fills and submits login forms on any https site from an encrypted file in iCloud Drive.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }, "default_title": "AutoLogin" },
  "permissions": ["nativeMessaging", "storage", "webRequest"],
  "host_permissions": ["https://auth.runi.ac.il/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
